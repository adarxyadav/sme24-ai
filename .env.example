# Supabase (EU project). Publishable key is RLS-scoped and safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key — server-only; bypasses RLS. Used by lib/supabase/service.ts from
# trigger/ tasks, webhooks, and app/api/ routes that authenticate the session.
SUPABASE_SECRET_KEY=
# CLI only (supabase link / db push): not read by the app.
SUPABASE_DB_PASSWORD=
SUPABASE_ACCESS_TOKEN=

# Trigger.dev — the pipeline orchestrator. Project sme24-ehs, default region
# eu-central-1 (Frankfurt), matching Supabase. Runs are also pinned to that
# region at each trigger site.
#
# The secret key is per-environment: the dev key is what `trigger.dev dev` and
# the Next.js route use locally; the deployed environment gets its own. Copy it
# from the dashboard under API keys.
TRIGGER_SECRET_KEY=

# Parallel Task API — stage-1 company research (the paid call). Receives public
# company identifiers only, never customer data.
PARALLEL_API_KEY=

# Testing seams — leave unset in normal use.
# FORCE_STAGE1_FAILURE: any value makes the stage-1 task throw before the
# Parallel call, to verify the failure path writes `failed` + error + a log row.
# PIPELINE_MODEL: overrides the pipeline model (pipeline-rules.md, Stack).
FORCE_STAGE1_FAILURE=
PIPELINE_MODEL=
