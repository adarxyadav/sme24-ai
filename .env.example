# Supabase (EU project). Publishable key is RLS-scoped and safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key — server-only; bypasses RLS. Used by lib/supabase/service.ts from
# trigger/ tasks, webhooks, and app/api/ routes that authenticate the session.
SUPABASE_SECRET_KEY=
# CLI only (supabase link / db push): not read by the app.
SUPABASE_DB_PASSWORD=
SUPABASE_ACCESS_TOKEN=

# Trigger.dev — the pipeline orchestrator. Project sme24-ehs, default region
# eu-central-1 (Frankfurt), matching Supabase. Runs are also pinned to that
# region at each trigger site.
#
# The secret key is per-environment: the dev key is what `trigger.dev dev` and
# the Next.js route use locally; the deployed environment gets its own. Copy it
# from the dashboard under API keys.
TRIGGER_SECRET_KEY=

# Parallel Task API — stage-1 company research (the paid call). Receives public
# company identifiers only, never customer data.
PARALLEL_API_KEY=

# Vercel AI Gateway — stage-2 KPI extraction and every later Claude call. The
# AI SDK reads it itself; the model string is anthropic/claude-sonnet-5
# (pipeline-rules.md, Stack). Needed by `trigger.dev dev` locally and set in
# the Trigger.dev environment for deploys.
AI_GATEWAY_API_KEY=

# Testing seams — leave unset in normal use.
# FORCE_STAGE1_FAILURE: any value makes the stage-1 task throw before the
# Parallel call, to verify the failure path writes `failed` + error + a log row.
# PIPELINE_MODEL: overrides the pipeline model (pipeline-rules.md, Stack).
# FORCE_ENQUEUE_FAILURE: any value makes the trigger route's enqueue throw
# after the run row is committed, stranding a `queued` run for the sweeper to
# recover (T-010).
# FORCE_STAGE2_RETRY: attempt 1 of the stage-2 task throws after its KPI swap
# has committed, so attempt 2 replays the swap over existing rows (T-005).
# FORCE_STAGE2_BAD_METRIC: injects a non-canonical metric into the stage-2
# output after the model call, to prove the write path rejects it (T-005).
# FORCE_STAGE1_HANG / FORCE_STAGE2_HANG: the stage sleeps ten minutes after
# its claim (EXECUTING, not WAITING), long enough to cancel the run or kill the
# worker and watch the stalled-run sweeper act — or not (T-011).
# FORCE_STAGE1_RETRY: attempt 1 of the stage-1 task throws after its claim, so
# attempt 2 must re-win the claim it already holds; `always` throws on every
# attempt to reach onFailure (T-012).
# FORCE_STAGE3_EMPTY: stage 3 skips Parallel and the model and stores an empty
# peer set, to prove the insufficient-data path without a paid call (T-016).
# FORCE_STAGE1_ESCALATE: stage 1 sees zero numeric web KPIs after extraction,
# so a base run escalates to ultra (T-021). FORCE_STAGE3_NO_RATES: the base
# peer result's rates are nulled, so stage 3 escalates its peer call to ultra
# (a paid ultra call) (T-021).
FORCE_STAGE1_FAILURE=
FORCE_STAGE1_RETRY=
FORCE_STAGE1_ESCALATE=
FORCE_STAGE3_EMPTY=
FORCE_STAGE3_NO_RATES=
FORCE_ENQUEUE_FAILURE=
FORCE_STAGE1_HANG=
FORCE_STAGE2_HANG=
FORCE_STAGE2_RETRY=
FORCE_STAGE2_BAD_METRIC=
PIPELINE_MODEL=
