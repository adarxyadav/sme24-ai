# Supabase (EU project). Publishable key is RLS-scoped and safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key — server-only; bypasses RLS. Used by lib/supabase/service.ts from
# trigger/ tasks, webhooks, and app/api/ routes that authenticate the session.
SUPABASE_SECRET_KEY=
# CLI only (supabase link / db push): not read by the app.
SUPABASE_DB_PASSWORD=
SUPABASE_ACCESS_TOKEN=
